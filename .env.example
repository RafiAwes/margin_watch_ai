# ==============================================================================
# MarginWatch - Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local development environment.
# 2. Replace all placeholder values with your local settings.
# 3. NEVER commit your actual '.env' file or any secret keys to version control.
# ==============================================================================

# ==============================================================================
# BACKEND CONFIGURATION (Django & DRF)
# ==============================================================================
# CRITICAL: Generate a strong, random 50+ character secret key for production.
# For local development only, an arbitrary non-empty string is sufficient.
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters

# Set to True for local development only. MUST be False in staging and production.
DJANGO_DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# MarginWatch defaults to local SQLite for Phase 1-5 development.
# Options: 'sqlite' or 'postgres'
DB_ENGINE=sqlite

# SQLite configuration (relative or absolute file path)
SQLITE_DB_NAME=db.sqlite3

# PostgreSQL configuration (planned for Phase 8+ production transition)
# DB_ENGINE=postgres
# POSTGRES_DB=marginwatch_db
# POSTGRES_USER=marginwatch_user
# POSTGRES_PASSWORD=replace-with-secure-db-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ==============================================================================
# CORS & FRONTEND INTEGRATION
# ==============================================================================
# Comma-separated list of origins authorized to make cross-site HTTP requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# AI PROVIDER CONFIGURATION (Server-Side Only)
# ==============================================================================
# Google Gemini API Key used strictly by the Django backend AI Risk Advisor service.
# CRITICAL SECURITY NOTE:
# - This key MUST NEVER be prefixed with NEXT_PUBLIC_ or exposed to the client.
# - The frontend communicates ONLY with the Django API, which proxies and validates AI requests.
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# FRONTEND CONFIGURATION (Next.js)
# ==============================================================================
# Public backend API URL accessible by the browser for client-side API requests.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
