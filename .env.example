# ==============================================================================
# MarginWatch — environment template
# ==============================================================================
# Copy to `.env.local` in the repository root (git-ignored). backend/config/settings.py
# loads, in order: <repo>/.env.local, <repo>/.env, backend/.env.local, backend/.env.
# Never commit real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# PostgreSQL connection string (e.g. Neon). Leave unset to use backend/db.sqlite3.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional direct (non-pooled) connection used for tests and migrations.
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/dbname?sslmode=require

# ------------------------------------------------------------------------------
# API / auth
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7

# ------------------------------------------------------------------------------
# Financial engine
# ------------------------------------------------------------------------------
# High budget-consumption warning (percent). Empty value disables the warning.
# MARGINWATCH_CONSUMPTION_WARNING_PCT=80.00

# ------------------------------------------------------------------------------
# AI Risk Advisor (server-side only — never put these in frontend/.env*)
# ------------------------------------------------------------------------------
# Key from https://aistudio.google.com/apikey. Without it the advisor returns AI_NOT_CONFIGURED.
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
# gemini-3.5-flash-lite is a good fallback when the larger Flash models are busy.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=10
# MARGINWATCH_AI_CACHE_SECONDS=86400
# MARGINWATCH_AI_RATE=10/hour

# ------------------------------------------------------------------------------
# Frontend (frontend/.env.local) — optional
# ------------------------------------------------------------------------------
# Only VITE_* variables reach the browser bundle; never put secrets in them.
# VITE_API_BASE_URL=http://localhost:8000/api/v1   (default: /api/v1 via the Vite proxy)
