# VITE_API_BASE_URL: Optional. Base URL of the Django REST API.
# Defaults to '/api/v1', which the Vite dev server proxies to http://127.0.0.1:8000.
# VITE_API_BASE_URL="http://localhost:8000/api/v1"

# NOTE: Never put GEMINI_API_KEY or any other secret here. Every VITE_* variable is
# bundled into the browser build. The Gemini AI Risk Advisor runs server-side only
# (see docs/ai-risk-advisor.md); configure its key in the backend environment.
